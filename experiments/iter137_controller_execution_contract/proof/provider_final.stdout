    "items": [
      {
        "key": "install-nvidia-driver",
        "value": "True"
      },
      {
        "key": "startup-script",
        "value": "#!/bin/bash\n# sentinel-gpu rescue: diagnose to serial console, free SAFE space only, restore sshd.\n# Never touches /opt/sentinel-stack outputs, /var/log/sentinel-*.log, or any *.jsonl evidence.\n{\necho \"===== SENTINEL RESCUE $(date -u) =====\"\necho \"--- df ---\"\ndf -h / /opt 2>/dev/null\necho \"--- top space users ---\"\ndu -xsh /var/log /var/lib/docker /opt/sentinel-stack /tmp /home 2>/dev/null\ndu -xsh /opt/sentinel-stack/* 2>/dev/null | sort -rh | head -12\necho \"--- evidence inventory ---\"\nls -la /opt/sentinel-stack/UniAD/sentinel_cand.jsonl 2>/dev/null || echo \"NO sentinel_cand.jsonl\"\nwc -l /opt/sentinel-stack/UniAD/sentinel_cand.jsonl 2>/dev/null\nls -la /opt/sentinel-stack/UniAD/sentinel_*.jsonl 2>/dev/null | tail -20\nls -la /var/log/sentinel-*.log 2>/dev/null\nls /opt/sentinel-stack/NeuroNCAP/outoutput/ 2>/dev/null\nls /tmp/analyze_cand.py 2>/dev/null || echo \"NO /tmp/analyze_cand.py (tmp cleared by boot)\"\necho \"--- safe cleanup ---\"\njournalctl --vacuum-size=200M 2>&1 | tail -2\napt-get clean 2>/dev/null\ndocker builder prune -f 2>&1 | tail -1\nrm -rf /var/cache/apt/archives/*.deb\necho \"--- df after ---\"\ndf -h /\necho \"--- sshd ---\"\nsystemctl restart ssh sshd 2>/dev/null\nsystemctl is-active ssh sshd 2>/dev/null\nsshd -t 2>&1 || true\necho \"===== SENTINEL RESCUE DONE =====\"\n} > /dev/console 2>&1\ncp /dev/null /var/run/rescue-marker 2>/dev/null || true\n"
      }
    ],
    "kind": "compute#metadata"
  },
